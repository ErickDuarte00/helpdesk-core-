---
/**
 * ARCHIVO: src/pages/index.astro
 * DESCRIPCIÓN: Página de inicio y formulario de autenticación (Login).
 * Solicita credenciales al usuario, realiza la autenticación contra la API REST,
 * guarda el token JWT/sesión en localStorage y redirige al panel según su rol (RBAC).
 */

import Layout from "../layouts/Layout.astro";
---

<Layout title="Iniciar Sesión">
  <!-- Contenedor centrado para la tarjeta de autenticación -->
  <div class="flex items-center justify-center min-h-screen p-4">
    <div
      class="w-full max-w-md p-8 bg-slate-800 border border-slate-700 rounded-xl shadow-2xl"
    >
      <!-- Logotipo y encabezado -->
      <div class="mb-6 text-center">
        <h1 class="text-2xl font-bold tracking-tight text-white">
          HELPDESK <span class="text-blue-500">IT</span>
        </h1>
        <p class="text-sm text-slate-400 mt-1">
          Ingresa tus credenciales para continuar
        </p>
      </div>

      <!-- Formulario de inicio de sesión -->
      <form id="login-form" class="space-y-4">
        <div>
          <label
            class="block text-xs font-semibold text-slate-300 uppercase mb-1"
            >Correo Electrónico</label
          >
          <input
            type="email"
            id="email"
            required
            placeholder="usuario@empresa.com"
            class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:border-blue-500"
          />
        </div>

        <div>
          <label
            class="block text-xs font-semibold text-slate-300 uppercase mb-1"
            >Contraseña</label
          >
          <input
            type="password"
            id="password"
            required
            placeholder="••••••••"
            class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:border-blue-500"
          />
        </div>

        <button
          type="submit"
          class="w-full py-2.5 px-4 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-lg shadow-md transition duration-200"
        >
          Entrar al Sistema
        </button>

        <!-- Mensaje dinámico de error o estado -->
        <p
          id="error-msg"
          class="text-sm text-red-400 text-center font-medium hidden"
        >
        </p>

        <!-- Acceso Rápido Demo -->
        <div class="pt-4 border-t border-slate-700 text-center">
          <p class="text-xs text-slate-400 uppercase font-semibold tracking-wider mb-2">
            Acceso Rápido (Demo)
          </p>
          <div class="grid grid-cols-3 gap-2">
            <button
              type="button"
              id="btn-demo-admin"
              class="px-2 py-1.5 bg-slate-700 hover:bg-slate-600 text-xs font-medium text-purple-300 rounded border border-purple-500/30 transition"
            >
              Admin
            </button>
            <button
              type="button"
              id="btn-demo-tecnico"
              class="px-2 py-1.5 bg-slate-700 hover:bg-slate-600 text-xs font-medium text-blue-300 rounded border border-blue-500/30 transition"
            >
              Técnico
            </button>
            <button
              type="button"
              id="btn-demo-empleado"
              class="px-2 py-1.5 bg-slate-700 hover:bg-slate-600 text-xs font-medium text-emerald-300 rounded border border-emerald-500/30 transition"
            >
              Empleado
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  // Referencias a los elementos del formulario y caja de error
  const loginForm = document.getElementById("login-form") as HTMLFormElement;
  const emailInput = document.getElementById("email") as HTMLInputElement;
  const passwordInput = document.getElementById("password") as HTMLInputElement;
  const errorMsg = document.getElementById("error-msg") as HTMLParagraphElement;

  const API_URL =
    import.meta.env.PUBLIC_API_URL || "http://18.225.192.108:3000/api";

  const clearLoginForm = () => {
    loginForm.reset();
  };

  const executeLogin = async (email: string, password: string) => {
    errorMsg.classList.add("hidden");

    try {
      const res = await fetch(`${API_URL}/auth/login`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, password }),
      });

      if (!res.ok) {
        let errorDescription = `Error del servidor (${res.status})`;
        try {
          const errData = await res.json();
          errorDescription = errData.error || errorDescription;
        } catch {
          // Si el servidor devolvió HTML (como un 404 o 502), no crashea
        }
        throw new Error(errorDescription);
      }

      const data = await res.json();
      clearLoginForm();

      localStorage.setItem("token", data.token);
      localStorage.setItem("user", JSON.stringify(data.user));

      const role = String(data.user.role || "")
        .toLowerCase()
        .trim();

      if (role === "empleado") {
        window.location.replace("/empleado");
      } else if (role === "tecnico" || role === "técnico") {
        window.location.replace("/tecnico");
      } else if (role === "admin" || role === "administrador") {
        window.location.replace("/admin");
      } else {
        window.location.replace("/dashboard");
      }
    } catch (err: any) {
      errorMsg.textContent = err.message;
      errorMsg.classList.remove("hidden");
    }
  };

  // Manejador del evento de envío manual del formulario
  loginForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    await executeLogin(emailInput.value.trim(), passwordInput.value);
  });

  // Credenciales predefinidas de demostración
  const DEMO_CREDENTIALS = {
    admin: { email: "admin@test.com", pass: "admin" },
    tecnico: { email: "erick@test.com", pass: "Password123!" },
    empleado: { email: "empleado@test.com", pass: "Contrasenia1" }
  };

  // Event listeners para los botones de acceso rápido
  document.getElementById("btn-demo-admin")?.addEventListener("click", () => {
    executeLogin(DEMO_CREDENTIALS.admin.email, DEMO_CREDENTIALS.admin.pass);
  });
  document.getElementById("btn-demo-tecnico")?.addEventListener("click", () => {
    executeLogin(DEMO_CREDENTIALS.tecnico.email, DEMO_CREDENTIALS.tecnico.pass);
  });
  document.getElementById("btn-demo-empleado")?.addEventListener("click", () => {
    executeLogin(DEMO_CREDENTIALS.empleado.email, DEMO_CREDENTIALS.empleado.pass);
  });

  // AUTO-LOGIN por parámetro de URL (?demo=admin, ?demo=tecnico, ?demo=empleado)
  const urlParams = new URLSearchParams(window.location.search);
  const demoRole = urlParams.get("demo")?.toLowerCase().trim();

  if (demoRole && DEMO_CREDENTIALS[demoRole]) {
    errorMsg.textContent = `Iniciando sesión demo como ${demoRole}...`;
    errorMsg.classList.remove("hidden");
    errorMsg.classList.remove("text-red-400");
    errorMsg.classList.add("text-blue-400");
    executeLogin(DEMO_CREDENTIALS[demoRole].email, DEMO_CREDENTIALS[demoRole].pass);
  }
</script>
