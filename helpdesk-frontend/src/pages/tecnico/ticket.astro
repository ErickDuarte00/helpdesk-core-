---
/**
 * ARCHIVO: src/pages/tecnico/ticket.astro
 * DESCRIPCIÓN: Detalle y atención de incidencias para el Técnico de TI.
 * Permite autoasignarse el ticket (si está libre o inactivo), cambiar el estado
 * y documentar avances en la bitácora técnica de comentarios.
 */

import Layout from "../../layouts/Layout.astro";
---

<Layout title="Gestión de Incidencia | Soporte TI">
    <!-- Encabezado con navegación y credenciales -->
    <header
        class="bg-slate-800 border-b border-slate-700 px-6 py-4 flex justify-between items-center"
    >
        <div class="flex items-center gap-4">
            <div class="text-xl font-black tracking-wider text-white">
                HELPDESK <span class="text-blue-500">IT</span>
            </div>
            <a
                href="/tecnico"
                class="text-sm text-slate-400 hover:text-white transition"
            >
                ← Volver al listado
            </a>
        </div>

        <!-- Nombre, rol al lado y botón Salir -->
        <div class="flex items-center gap-3">
            <span id="user-name" class="font-bold text-white text-base"></span>
            <span
                id="user-role"
                class="px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-slate-700/50 border border-slate-600 text-slate-300"
            ></span>
            <button
                id="btn-logout"
                class="px-3.5 py-1.5 border border-slate-600 hover:bg-slate-700 text-slate-200 rounded-lg text-sm transition ml-1"
            >
                Salir
            </button>
        </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-8">
        <!-- Mensaje de carga inicial -->
        <div id="loading" class="text-center text-slate-400 py-12">
            Cargando datos de la incidencia...
        </div>

        <!-- Caja de error visible si la petición falla -->
        <div
            id="error-box"
            class="hidden text-center bg-red-950/40 border border-red-800/60 rounded-xl p-6 text-red-300"
        >
            <p id="error-text" class="font-semibold text-sm mb-3">
                No se pudo cargar la información del ticket.
            </p>
            <a
                href="/tecnico"
                class="text-xs px-3.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-white rounded-lg transition border border-slate-600"
            >
                Regresar al panel de tickets
            </a>
        </div>

        <!-- Contenedor principal del ticket -->
        <div id="ticket-container" class="hidden space-y-6">
            <!-- Ficha de Encabezado -->
            <div
                class="bg-slate-800 border border-slate-700 rounded-xl p-6 shadow"
            >
                <div
                    class="flex flex-wrap justify-between items-start gap-2 mb-3"
                >
                    <span
                        id="ticket-code"
                        class="text-sm font-mono font-bold text-blue-400"
                        >INC-000000</span
                    >
                    <div class="flex gap-2">
                        <span
                            id="badge-priority"
                            class="px-2.5 py-0.5 rounded text-xs font-semibold"
                            >Prioridad</span
                        >
                        <span
                            id="badge-status"
                            class="px-2.5 py-0.5 rounded text-xs font-semibold"
                            >Estado</span
                        >
                    </div>
                </div>

                <h1
                    id="ticket-title"
                    class="text-2xl font-bold text-white mb-4"
                >
                    Título de la incidencia
                </h1>

                <div
                    class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs border-t border-slate-700/60 pt-4"
                >
                    <div>
                        <span class="text-slate-400 block mb-0.5"
                            >Solicitante:</span
                        >
                        <span
                            id="ticket-solicitante"
                            class="font-medium text-white text-sm"></span>
                    </div>
                    <div>
                        <span class="text-slate-400 block mb-0.5"
                            >Categoría:</span
                        >
                        <span
                            id="ticket-category"
                            class="font-medium text-white text-sm"></span>
                    </div>
                    <div>
                        <span class="text-slate-400 block mb-0.5"
                            >Prioridad:</span
                        >
                        <span
                            id="ticket-priority"
                            class="font-medium text-white text-sm"></span>
                    </div>
                    <div>
                        <span class="text-slate-400 block mb-0.5">Estado:</span>
                        <span
                            id="ticket-status-text"
                            class="font-medium text-white text-sm"></span>
                    </div>
                </div>
            </div>

            <!-- Descripción -->
            <div
                class="bg-slate-800 border border-slate-700 rounded-xl p-6 shadow"
            >
                <h2
                    class="text-sm font-bold text-slate-300 uppercase tracking-wide border-b border-slate-700/80 pb-2 mb-3"
                >
                    Descripción del problema
                </h2>
                <p
                    id="ticket-description"
                    class="text-sm text-slate-200 whitespace-pre-line leading-relaxed"
                >
                </p>
            </div>

            <!-- Panel Operativo: Técnico Asignado y Cambio de Estado -->
            <div
                class="bg-slate-800 border border-slate-700 rounded-xl p-6 shadow flex flex-col md:flex-row md:items-center justify-between gap-4"
            >
                <div>
                    <span
                        class="text-xs text-slate-400 block uppercase font-semibold mb-1"
                        >Técnico Asignado:</span
                    >
                    <div class="flex items-center gap-3">
                        <span
                            id="ticket-tech-name"
                            class="text-base font-bold text-white"
                            >Sin Asignar</span
                        >
                        <!-- Botón para asignarse el ticket -->
                        <button
                            id="btn-self-assign"
                            class="hidden text-xs px-2.5 py-1 bg-blue-600 hover:bg-blue-500 text-white rounded transition shadow-sm"
                        >
                            Asignármelo a mí
                        </button>
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <label
                        for="select-status"
                        class="text-xs text-slate-300 uppercase font-semibold"
                        >Cambiar estado:</label
                    >
                    <select
                        id="select-status"
                        class="bg-slate-900 border border-slate-600 text-white text-sm rounded-lg px-3 py-2 focus:outline-none focus:border-blue-500 cursor-pointer"
                    >
                        <option value="Abierto">Abierto</option>
                        <option value="Asignado">Asignado</option>
                        <option value="En progreso">En progreso</option>
                        <option value="Resuelto">Resuelto</option>
                        <option value="Cerrado">Cerrado</option>
                    </select>
                    <button
                        id="btn-update-status"
                        class="bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs px-3 py-2 rounded-lg transition"
                    >
                        Actualizar
                    </button>
                </div>
            </div>

            <!-- Comentarios y Bitácora -->
            <div
                class="bg-slate-800 border border-slate-700 rounded-xl p-6 shadow"
            >
                <h2
                    class="text-sm font-bold text-slate-300 uppercase tracking-wide border-b border-slate-700/80 pb-2 mb-4"
                >
                    Comentarios e Historial de Soporte
                </h2>

                <div id="comments-list" class="space-y-3 mb-6">
                    <!-- Inyectado dinámicamente -->
                </div>

                <form
                    id="comment-form"
                    class="space-y-3 border-t border-slate-700/80 pt-4"
                >
                    <label
                        class="block text-xs font-semibold text-slate-400 uppercase"
                        >Documentar avance o respuesta:</label
                    >
                    <textarea
                        id="comment-text"
                        rows="3"
                        required
                        placeholder="Escribe las notas de soporte técnico..."
                        class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-blue-500"
                    ></textarea>
                    <div class="flex justify-end">
                        <button
                            type="submit"
                            class="bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm px-4 py-2 rounded-lg transition"
                        >
                            Agregar Comentario
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </main>
</Layout>

<script>
    const API_URL = "http://127.0.0.1:3000/api";
    const token = localStorage.getItem("token");
    const user = JSON.parse(localStorage.getItem("user") || "{}");

    // Validación de sesión
    if (!token || !user.id) {
        window.location.href = "/";
    }

    // Comprobar rol de técnico o admin
    const userRole = String(user.role || "")
        .toLowerCase()
        .trim();
    if (
        userRole !== "tecnico" &&
        userRole !== "admin" &&
        userRole !== "administrador"
    ) {
        window.location.href = "/empleado";
    }

    // Asignar nombre y rol de forma segura
    const nameEl = document.getElementById("user-name");
    const roleEl = document.getElementById("user-role");
    if (nameEl) nameEl.textContent = user.name;
    if (roleEl) roleEl.textContent = user.role;

    document.getElementById("btn-logout")?.addEventListener("click", () => {
        localStorage.clear();
        window.location.replace("/"); // <-- Reemplaza la entrada en el historial para no poder retroceder
    });

    // Extraer ID del ticket de la URL (?id=X)
    const urlParams = new URLSearchParams(window.location.search);
    const ticketId = urlParams.get("id");

    const loadingEl = document.getElementById("loading")!;
    const errorBox = document.getElementById("error-box")!;
    const errorText = document.getElementById("error-text")!;
    const containerEl = document.getElementById("ticket-container")!;

    if (!ticketId) {
        loadingEl.classList.add("hidden");
        errorText.textContent =
            "No se especificó ningún identificador de ticket.";
        errorBox.classList.remove("hidden");
    }

    async function loadTicket() {
        try {
            const res = await fetch(`${API_URL}/tickets/${ticketId}`, {
                headers: { Authorization: `Bearer ${token}` },
            });

            if (!res.ok) {
                const errorData = await res.json().catch(() => ({}));
                loadingEl.classList.add("hidden");
                errorText.textContent =
                    errorData.error ||
                    `Error ${res.status}: No se pudo cargar el ticket.`;
                errorBox.classList.remove("hidden");
                return;
            }

            const { ticket, comments } = await res.json();

            // Inyectar datos en la ficha
            document.getElementById("ticket-code")!.textContent = ticket.code;
            document.getElementById("ticket-title")!.textContent = ticket.title;
            document.getElementById("ticket-solicitante")!.textContent =
                ticket.solicitante || "Sin solicitante";
            document.getElementById("ticket-category")!.textContent =
                ticket.category;
            document.getElementById("ticket-priority")!.textContent =
                ticket.priority;
            document.getElementById("ticket-status-text")!.textContent =
                ticket.status;
            document.getElementById("ticket-description")!.textContent =
                ticket.description;
            document.getElementById("ticket-tech-name")!.textContent =
                ticket.tecnico_asignado || "Sin Asignar";

            // Badges
            const pBadge = document.getElementById("badge-priority")!;
            pBadge.textContent = ticket.priority;
            pBadge.className = `px-2.5 py-0.5 rounded text-xs font-semibold ${
                ticket.priority === "Crítica"
                    ? "bg-red-900/60 text-red-300"
                    : ticket.priority === "Alta"
                      ? "bg-amber-900/60 text-amber-300"
                      : "bg-slate-700 text-slate-300"
            }`;

            const sBadge = document.getElementById("badge-status")!;
            sBadge.textContent = ticket.status;
            sBadge.className = `px-2.5 py-0.5 rounded text-xs font-semibold ${
                ticket.status === "Abierto"
                    ? "bg-slate-700 text-slate-300"
                    : ticket.status === "Asignado"
                      ? "bg-indigo-900/60 text-indigo-300"
                      : ticket.status === "En progreso"
                        ? "bg-blue-900/60 text-blue-300"
                        : ticket.status === "Resuelto"
                          ? "bg-emerald-900/60 text-emerald-300"
                          : "bg-slate-800 text-slate-500"
            }`;

            // Select de estados
            const selectStatus = document.getElementById(
                "select-status",
            ) as HTMLSelectElement;
            selectStatus.value = ticket.status;

            // Regla de tickets cerrados o resueltos
            const isClosedOrResolved =
                ticket.status === "Resuelto" || ticket.status === "Cerrado";
            const btnSelfAssign = document.getElementById("btn-self-assign")!;
            const btnUpdateStatus = document.getElementById(
                "btn-update-status",
            ) as HTMLButtonElement;

            if (isClosedOrResolved) {
                // En casos cerrados/resueltos no se permite reasignar
                btnSelfAssign.classList.add("hidden");
                selectStatus.disabled = true;
                btnUpdateStatus.disabled = true;
                btnUpdateStatus.classList.add(
                    "opacity-50",
                    "cursor-not-allowed",
                );
            } else {
                selectStatus.disabled = false;
                btnUpdateStatus.disabled = false;
                btnUpdateStatus.classList.remove(
                    "opacity-50",
                    "cursor-not-allowed",
                );

                // Evaluar asignación
                if (!ticket.assigned_to) {
                    btnSelfAssign.textContent = "Asignármelo a mí";
                    btnSelfAssign.classList.remove("hidden");
                } else if (ticket.assigned_to === user.id) {
                    btnSelfAssign.classList.add("hidden");
                } else {
                    // Asignado a otro: verificar inactividad (+24h)
                    const lastUpdate = new Date(
                        ticket.updated_at || ticket.created_at,
                    );
                    const hoursInactive =
                        (new Date().getTime() - lastUpdate.getTime()) /
                        (1000 * 60 * 60);

                    if (hoursInactive >= 24) {
                        btnSelfAssign.textContent = `Tomar ticket (Inactivo ${Math.floor(hoursInactive)}h)`;
                        btnSelfAssign.classList.remove("hidden");
                    } else {
                        btnSelfAssign.classList.add("hidden");
                    }
                }
            }

            // Renderizar comentarios
            const commentsContainer = document.getElementById("comments-list")!;
            commentsContainer.innerHTML = "";

            if (!comments || comments.length === 0) {
                commentsContainer.innerHTML = `<p class="text-xs text-slate-500 italic">No hay notas registradas aún.</p>`;
            } else {
                comments.forEach((c: any) => {
                    const date = new Date(c.created_at).toLocaleString();
                    const div = document.createElement("div");
                    div.className =
                        "bg-slate-900/60 border border-slate-700/60 rounded-lg p-3 text-sm";
                    div.innerHTML = `
            <div class="flex justify-between items-center text-xs mb-1">
              <span class="font-bold ${c.autor_rol === "empleado" ? "text-slate-300" : "text-blue-400"}">
                ${c.autor} (${c.autor_rol})
              </span>
              <span class="text-slate-500">${date}</span>
            </div>
            <p class="text-slate-200 whitespace-pre-line">${c.comment}</p>
          `;
                    commentsContainer.appendChild(div);
                });
            }

            // Ocultar cargador y mostrar ticket
            loadingEl.classList.add("hidden");
            containerEl.classList.remove("hidden");
        } catch (err: any) {
            console.error("Error al cargar ticket:", err);
            loadingEl.classList.add("hidden");
            errorText.textContent =
                "Error de conexión al cargar la incidencia. Revisa que el backend esté activo.";
            errorBox.classList.remove("hidden");
        }
    }

    // Actualizar Estado
    document
        .getElementById("btn-update-status")
        ?.addEventListener("click", async () => {
            const newStatus = (
                document.getElementById("select-status") as HTMLSelectElement
            ).value;

            try {
                const res = await fetch(
                    `${API_URL}/tickets/${ticketId}/status`,
                    {
                        method: "PATCH",
                        headers: {
                            "Content-Type": "application/json",
                            Authorization: `Bearer ${token}`,
                        },
                        body: JSON.stringify({ status: newStatus }),
                    },
                );

                if (res.ok) {
                    await fetch(`${API_URL}/tickets/${ticketId}/comments`, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            Authorization: `Bearer ${token}`,
                        },
                        body: JSON.stringify({
                            comment: `Estado actualizado a "${newStatus}".`,
                        }),
                    });
                    loadTicket();
                } else {
                    alert("No se pudo actualizar el estado.");
                }
            } catch (err) {
                console.error(err);
            }
        });

    // Asignarse el ticket
    document
        .getElementById("btn-self-assign")
        ?.addEventListener("click", async () => {
            try {
                const res = await fetch(
                    `${API_URL}/tickets/${ticketId}/status`,
                    {
                        method: "PATCH",
                        headers: {
                            "Content-Type": "application/json",
                            Authorization: `Bearer ${token}`,
                        },
                        body: JSON.stringify({
                            assigned_to: user.id,
                            status: "En progreso",
                        }),
                    },
                );

                if (res.ok) {
                    await fetch(`${API_URL}/tickets/${ticketId}/comments`, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            Authorization: `Bearer ${token}`,
                        },
                        body: JSON.stringify({
                            comment: `El técnico ${user.name} tomó la atención de esta incidencia.`,
                        }),
                    });
                    loadTicket();
                } else {
                    alert("No se pudo asignar el ticket.");
                }
            } catch (err) {
                console.error(err);
            }
        });

    // Agregar Comentario
    document
        .getElementById("comment-form")
        ?.addEventListener("submit", async (e) => {
            e.preventDefault();
            const commentInput = document.getElementById(
                "comment-text",
            ) as HTMLTextAreaElement;
            const comment = commentInput.value.trim();
            if (!comment) return;

            try {
                const res = await fetch(
                    `${API_URL}/tickets/${ticketId}/comments`,
                    {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            Authorization: `Bearer ${token}`,
                        },
                        body: JSON.stringify({ comment }),
                    },
                );

                if (res.ok) {
                    commentInput.value = "";
                    loadTicket();
                } else {
                    alert("Error al enviar comentario.");
                }
            } catch (err) {
                console.error(err);
            }
        });

    if (ticketId) {
        loadTicket();
    }
</script>
