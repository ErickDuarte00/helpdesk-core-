---
/**
 * ARCHIVO: src/pages/empleado/index.astro
 * DESCRIPCIÓN: Panel de incidencias del empleado.
 * Muestra el nombre real del usuario autenticado y su rol 'EMPLEADO' en la esquina superior derecha.
 */
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Mis Tickets | Empleado">
    <header
        class="bg-slate-800 border-b border-slate-700 px-6 py-4 flex justify-between items-center"
    >
        <div class="text-xl font-black tracking-wider text-white">
            HELPDESK <span class="text-blue-500">IT</span>
        </div>

        <!-- Usuario y Rol en la esquina superior derecha -->
        <div class="flex items-center gap-3">
            <span id="user-name" class="text-sm font-semibold text-white"
            ></span>
            <span
                id="user-role"
                class="text-xs px-2.5 py-0.5 rounded-full font-mono uppercase font-bold tracking-wide bg-slate-700 text-slate-300 border border-slate-600"
            ></span>
            <button
                id="btn-logout"
                class="px-3 py-1.5 border border-slate-600 hover:bg-slate-700 text-slate-300 rounded text-sm transition ml-2"
            >
                Salir
            </button>
        </div>
    </header>

    <main class="max-w-5xl mx-auto px-4 py-8">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-bold text-white">Mis tickets</h1>
            <button
                id="btn-open-modal"
                class="bg-blue-600 hover:bg-blue-500 text-white font-medium px-4 py-2 rounded-lg transition shadow-md"
            >
                + Crear Ticket
            </button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
            <div
                class="bg-slate-800 p-5 rounded-xl border border-slate-700 text-center"
            >
                <p class="text-sm text-slate-400 font-medium">Abiertos</p>
                <p
                    id="stat-abiertos"
                    class="text-3xl font-extrabold text-white mt-1"
                >
                    0
                </p>
            </div>
            <div
                class="bg-slate-800 p-5 rounded-xl border border-slate-700 text-center"
            >
                <p class="text-sm text-slate-400 font-medium">En curso</p>
                <p
                    id="stat-curso"
                    class="text-3xl font-extrabold text-blue-400 mt-1"
                >
                    0
                </p>
            </div>
            <div
                class="bg-slate-800 p-5 rounded-xl border border-slate-700 text-center"
            >
                <p class="text-sm text-slate-400 font-medium">Resueltos</p>
                <p
                    id="stat-resueltos"
                    class="text-3xl font-extrabold text-emerald-400 mt-1"
                >
                    0
                </p>
            </div>
        </div>

        <!-- Tabla -->
        <div
            class="bg-slate-800 border border-slate-700 rounded-xl overflow-hidden shadow"
        >
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr
                        class="border-b border-slate-700 bg-slate-850 text-slate-400"
                    >
                        <th class="p-3.5">Código</th>
                        <th class="p-3.5">Problema</th>
                        <th class="p-3.5">Categoría</th>
                        <th class="p-3.5">Estado</th>
                        <th class="p-3.5 text-right">Detalle</th>
                    </tr>
                </thead>
                <tbody
                    id="tickets-body"
                    class="divide-y divide-slate-700 text-slate-200"
                >
                    <!-- Dinámico -->
                </tbody>
            </table>
        </div>
    </main>

    <!-- Modal Crear Ticket -->
    <div
        id="modal-create"
        class="fixed inset-0 bg-black/75 flex items-center justify-center p-4 hidden z-50"
    >
        <div
            class="bg-slate-800 border border-slate-700 rounded-xl w-full max-w-lg p-6 shadow-2xl"
        >
            <h2 class="text-xl font-bold text-white mb-4">
                Crear nuevo ticket
            </h2>

            <form id="create-form" class="space-y-4">
                <div>
                    <label
                        class="block text-xs font-semibold text-slate-300 uppercase mb-1"
                        >Título:</label
                    >
                    <input
                        type="text"
                        id="ticket-title"
                        required
                        class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-blue-500"
                        placeholder="Ej: No puedo acceder al sistema de inventarios"
                    />
                </div>

                <div>
                    <label
                        class="block text-xs font-semibold text-slate-300 uppercase mb-1"
                        >Descripción:</label
                    >
                    <textarea
                        id="ticket-desc"
                        rows="3"
                        required
                        class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-blue-500"
                        placeholder="Al iniciar sesión aparece 'Connection refused'"
                    ></textarea>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label
                            class="block text-xs font-semibold text-slate-300 uppercase mb-1"
                            >Categoría:</label
                        >
                        <select
                            id="ticket-category"
                            required
                            class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none"
                        >
                            <option value="Software">Software</option>
                            <option value="Hardware">Hardware</option>
                            <option value="Red">Red</option>
                            <option value="Accesos">Accesos</option>
                            <option value="Servidores">Servidores</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>
                    <div>
                        <label
                            class="block text-xs font-semibold text-slate-300 uppercase mb-1"
                            >Prioridad:</label
                        >
                        <select
                            id="ticket-priority"
                            required
                            class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none"
                        >
                            <option value="Baja">Baja</option>
                            <option value="Media" selected>Media</option>
                            <option value="Alta">Alta</option>
                            <option value="Crítica">Crítica</option>
                        </select>
                    </div>
                </div>

                <div class="flex justify-end gap-3 pt-3">
                    <button
                        type="button"
                        id="btn-close-modal"
                        class="px-4 py-2 border border-slate-600 hover:bg-slate-700 rounded-lg text-slate-300 text-sm"
                        >Cancelar</button
                    >
                    <button
                        type="submit"
                        class="px-4 py-2 bg-blue-600 hover:bg-blue-500 rounded-lg text-white font-semibold text-sm"
                        >Crear Ticket</button
                    >
                </div>
            </form>
        </div>
    </div>
</Layout>

<script>
    const API_URL = "http://127.0.0.1:3000/api";
    const token = localStorage.getItem("token");
    const user = JSON.parse(localStorage.getItem("user") || "{}");

    if (!token || !user.id) {
        window.location.href = "/";
    }

    if (user.role !== "empleado") {
        window.location.href = user.role === "tecnico" ? "/tecnico" : "/admin";
    }

    // Carga de nombre y rol dinámico en la esquina superior derecha
    document.getElementById("user-name")!.textContent = user.name;
    document.getElementById("user-role")!.textContent = user.role;

    // CÓDIGO CORREGIDO:
    document.getElementById("btn-logout")?.addEventListener("click", () => {
        localStorage.clear();
        window.location.replace("/"); // <-- Reemplaza la entrada en el historial para no poder retroceder
    });

    const modal = document.getElementById("modal-create")!;
    document
        .getElementById("btn-open-modal")!
        .addEventListener("click", () => modal.classList.remove("hidden"));
    document
        .getElementById("btn-close-modal")!
        .addEventListener("click", () => modal.classList.add("hidden"));

    async function loadMyTickets() {
        try {
            const res = await fetch(`${API_URL}/tickets`, {
                headers: { Authorization: `Bearer ${token}` },
            });
            if (!res.ok) return;
            const data = await res.json();

            let abiertos = 0;
            let enCurso = 0;
            let resueltos = 0;

            const tbody = document.getElementById("tickets-body")!;
            tbody.innerHTML = "";

            data.tickets.forEach((t: any) => {
                if (t.status === "Abierto" || t.status === "Asignado")
                    abiertos++;
                else if (t.status === "En progreso") enCurso++;
                else if (t.status === "Resuelto" || t.status === "Cerrado")
                    resueltos++;

                const tr = document.createElement("tr");
                tr.className = "hover:bg-slate-750 transition";
                tr.innerHTML = `
          <td class="p-3.5 font-mono font-bold text-blue-400">
            <a href="/empleado/ticket?id=${t.id}" class="hover:underline">${t.code}</a>
          </td>
          <td class="p-3.5 font-medium text-white">${t.title}</td>
          <td class="p-3.5 text-slate-400">${t.category}</td>
          <td class="p-3.5">
            <span class="px-2.5 py-0.5 rounded text-xs font-semibold ${
                t.status === "Abierto"
                    ? "bg-slate-700 text-slate-300"
                    : t.status === "En progreso"
                      ? "bg-blue-900/60 text-blue-300"
                      : t.status === "Resuelto"
                        ? "bg-emerald-900/60 text-emerald-300"
                        : "bg-slate-800 text-slate-400"
            }">
              ${t.status === "En progreso" ? "En curso" : t.status}
            </span>
          </td>
          <td class="p-3.5 text-right">
            <a href="/empleado/ticket?id=${t.id}" class="text-xs px-3 py-1 bg-slate-700 hover:bg-slate-600 rounded text-slate-200 transition">
              Ver detalle
            </a>
          </td>
        `;
                tbody.appendChild(tr);
            });

            document.getElementById("stat-abiertos")!.textContent =
                abiertos.toString();
            document.getElementById("stat-curso")!.textContent =
                enCurso.toString();
            document.getElementById("stat-resueltos")!.textContent =
                resueltos.toString();
        } catch (err) {
            console.error(err);
        }
    }

    document
        .getElementById("create-form")!
        .addEventListener("submit", async (e) => {
            e.preventDefault();
            const title = (
                document.getElementById("ticket-title") as HTMLInputElement
            ).value;
            const description = (
                document.getElementById("ticket-desc") as HTMLTextAreaElement
            ).value;
            const category = (
                document.getElementById("ticket-category") as HTMLSelectElement
            ).value;
            const priority = (
                document.getElementById("ticket-priority") as HTMLSelectElement
            ).value;

            const res = await fetch(`${API_URL}/tickets`, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    Authorization: `Bearer ${token}`,
                },
                body: JSON.stringify({
                    title,
                    description,
                    category,
                    priority,
                }),
            });

            if (res.ok) {
                modal.classList.add("hidden");
                (
                    document.getElementById("create-form") as HTMLFormElement
                ).reset();
                loadMyTickets();
            }
        });

    loadMyTickets();
</script>
