---
/**
 * ARCHIVO: src/pages/dashboard.astro
 * DESCRIPCIÓN: Panel de control general y gestión administrativa de incidencias.
 * Proporciona visualización de KPIs de soporte, filtrado multidimensional en tiempo real,
 * modal para creación de tickets, actualización reactiva de estados (para staff técnico)
 * y eliminación protegida de tickets exclusiva para administradores.
 */

import Layout from "../layouts/Layout.astro";
---

<Layout title="Dashboard de Incidencias">
  <!-- Barra de navegación con datos del usuario e inicio de sesión -->
  <header
    class="bg-slate-800 border-b border-slate-700 px-6 py-4 flex justify-between items-center"
  >
    <div class="text-xl font-black tracking-wider text-white">
      HELPDESK <span class="text-blue-500">IT</span>
    </div>
    <div class="flex items-center gap-4">
      <div class="text-right">
        <div id="user-name" class="text-sm font-semibold text-white">
          Usuario
        </div>
        <span
          id="user-role"
          class="text-xs px-2 py-0.5 rounded bg-slate-700 text-slate-300 uppercase font-mono"
          >Rol</span
        >
      </div>
      <button
        id="btn-logout"
        class="px-3 py-1.5 border border-slate-600 hover:bg-slate-700 text-slate-300 rounded text-sm transition"
      >
        Cerrar Sesión
      </button>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <!-- Tarjetas de métricas globales y KPIs del sistema -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      <div
        class="bg-slate-800 p-5 rounded-xl border border-slate-700 shadow-sm"
      >
        <p class="text-sm text-slate-400 font-medium">Tickets Abiertos</p>
        <p id="metric-abiertos" class="text-3xl font-extrabold text-white mt-1">
          0
        </p>
      </div>
      <div
        class="bg-slate-800 p-5 rounded-xl border border-slate-700 shadow-sm"
      >
        <p class="text-sm text-slate-400 font-medium">En Progreso</p>
        <p
          id="metric-progreso"
          class="text-3xl font-extrabold text-blue-400 mt-1"
        >
          0
        </p>
      </div>
      <div
        class="bg-slate-800 p-5 rounded-xl border border-slate-700 shadow-sm"
      >
        <p class="text-sm text-slate-400 font-medium">Incidencias Críticas</p>
        <p
          id="metric-criticos"
          class="text-3xl font-extrabold text-red-400 mt-1"
        >
          0
        </p>
      </div>
      <div
        class="bg-slate-800 p-5 rounded-xl border border-slate-700 shadow-sm"
      >
        <p class="text-sm text-slate-400 font-medium">Resueltos Hoy</p>
        <p
          id="metric-resueltos"
          class="text-3xl font-extrabold text-emerald-400 mt-1"
        >
          0
        </p>
      </div>
    </div>

    <!-- Barra de filtros reactivos y disparador de creación de tickets -->
    <div class="flex flex-col md:flex-row gap-3 justify-between mb-4">
      <div
        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-2 flex-grow"
      >
        <input
          type="text"
          id="filter-search"
          placeholder="Buscar incidencia o código..."
          class="bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-blue-500"
        />
        <select
          id="filter-status"
          class="bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none"
        >
          <option value="Todos">Estado: Todos</option>
          <option value="Abierto">Abierto</option>
          <option value="Asignado">Asignado</option>
          <option value="En progreso">En progreso</option>
          <option value="Resuelto">Resuelto</option>
          <option value="Cerrado">Cerrado</option>
        </select>
        <select
          id="filter-priority"
          class="bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none"
        >
          <option value="Todas">Prioridad: Todas</option>
          <option value="Baja">Baja</option>
          <option value="Media">Media</option>
          <option value="Alta">Alta</option>
          <option value="Crítica">Crítica</option>
        </select>
        <select
          id="filter-category"
          class="bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none"
        >
          <option value="Todas">Categoría: Todas</option>
          <option value="Hardware">Hardware</option>
          <option value="Software">Software</option>
          <option value="Red">Red</option>
          <option value="Accesos">Accesos</option>
          <option value="Servidores">Servidores</option>
          <option value="Otro">Otro</option>
        </select>
      </div>

      <button
        id="btn-open-create"
        class="bg-blue-600 hover:bg-blue-500 text-white font-semibold px-4 py-2 rounded-lg transition whitespace-nowrap shadow-md"
      >
        + Crear Ticket
      </button>
    </div>

    <!-- Tabla general de tickets con acciones basadas en roles -->
    <div
      class="bg-slate-800 border border-slate-700 rounded-xl overflow-x-auto shadow"
    >
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr class="border-b border-slate-700 bg-slate-850 text-slate-400">
            <th class="p-3">Código</th>
            <th class="p-3">Título</th>
            <th class="p-3">Categoría</th>
            <th class="p-3">Prioridad</th>
            <th class="p-3">Estado</th>
            <th class="p-3">Solicitante</th>
            <th class="p-3 text-right">Acciones</th>
          </tr>
        </thead>
        <tbody
          id="tickets-table-body"
          class="divide-y divide-slate-700 text-slate-200"
        >
          <!-- Filas inyectadas dinámicamente vía JavaScript -->
        </tbody>
      </table>
    </div>
  </main>

  <!-- Modal: Crear Ticket -->
  <div
    id="modal-create"
    class="fixed inset-0 bg-black/75 flex items-center justify-center p-4 hidden z-50"
  >
    <div
      class="bg-slate-800 border border-slate-700 rounded-xl w-full max-w-lg p-6 shadow-2xl"
    >
      <h2 class="text-xl font-bold text-white mb-4">Nueva Incidencia</h2>
      <form id="create-ticket-form" class="space-y-4">
        <div>
          <label
            class="block text-xs font-semibold text-slate-300 uppercase mb-1"
            >Título</label
          >
          <input
            type="text"
            id="t-title"
            required
            class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm"
            placeholder="Ej: No puedo acceder al ERP"
          />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label
              class="block text-xs font-semibold text-slate-300 uppercase mb-1"
              >Categoría</label
            >
            <select
              id="t-category"
              required
              class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm"
            >
              <option value="Software">Software</option>
              <option value="Hardware">Hardware</option>
              <option value="Red">Red</option>
              <option value="Accesos">Accesos</option>
              <option value="Servidores">Servidores</option>
              <option value="Otro">Otro</option>
            </select>
          </div>
          <div>
            <label
              class="block text-xs font-semibold text-slate-300 uppercase mb-1"
              >Prioridad</label
            >
            <select
              id="t-priority"
              required
              class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm"
            >
              <option value="Baja">Baja</option>
              <option value="Media" selected>Media</option>
              <option value="Alta">Alta</option>
              <option value="Crítica">Crítica</option>
            </select>
          </div>
        </div>
        <div>
          <label
            class="block text-xs font-semibold text-slate-300 uppercase mb-1"
            >Descripción</label
          >
          <textarea
            id="t-desc"
            rows="3"
            required
            class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm"
            placeholder="Describe a detalle el problema..."></textarea>
        </div>
        <div class="flex justify-end gap-2 pt-2">
          <button
            type="button"
            id="btn-close-create"
            class="px-4 py-2 border border-slate-600 hover:bg-slate-700 rounded-lg text-slate-300 text-sm"
            >Cancelar</button
          >
          <button
            type="submit"
            class="px-4 py-2 bg-blue-600 hover:bg-blue-500 rounded-lg text-white font-semibold text-sm"
            >Crear Ticket</button
          >
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  // Inicialización de rutas y sesión
  const API_URL = "http://127.0.0.1:3000/api";
  const user = JSON.parse(localStorage.getItem("user") || "{}");
  const token = localStorage.getItem("token");

  // Validación de autenticación en cliente
  if (!token || !user.id) {
    window.location.href = "/";
  }

  // Despliegue de credenciales en el encabezado
  document.getElementById("user-name")!.textContent = user.name;
  document.getElementById("user-role")!.textContent = user.role;

  // Manejo de cierre de sesión
  document.getElementById("btn-logout")!.addEventListener("click", () => {
    localStorage.clear();
    window.location.href = "/";
  });

  // Control de apertura y cierre del modal de creación
  const modal = document.getElementById("modal-create")!;
  document
    .getElementById("btn-open-create")!
    .addEventListener("click", () => modal.classList.remove("hidden"));
  document
    .getElementById("btn-close-create")!
    .addEventListener("click", () => modal.classList.add("hidden"));

  /**
   * Consulta las estadísticas globales de incidencias y actualiza las tarjetas de KPIs.
   */
  async function loadDashboard() {
    const currentToken = localStorage.getItem("token");
    try {
      const res = await fetch(`${API_URL}/tickets/dashboard`, {
        headers: { Authorization: `Bearer ${currentToken}` },
      });
      if (!res.ok) return;
      const data = await res.json();
      document.getElementById("metric-abiertos")!.textContent =
        data.stats.abiertos;
      document.getElementById("metric-progreso")!.textContent =
        data.stats.enProgreso;
      document.getElementById("metric-criticos")!.textContent =
        data.stats.criticos;
      document.getElementById("metric-resueltos")!.textContent =
        data.stats.resueltosHoy;
    } catch (err) {
      console.error(err);
    }
  }

  /**
   * Carga y renderiza el listado de tickets aplicando los filtros seleccionados,
   * adaptando controles de estado y acciones según el rol del usuario (empleado, técnico o admin).
   */
  async function loadTickets() {
    const currentToken = localStorage.getItem("token");
    const search = (
      document.getElementById("filter-search") as HTMLInputElement
    ).value;
    const status = (
      document.getElementById("filter-status") as HTMLSelectElement
    ).value;
    const priority = (
      document.getElementById("filter-priority") as HTMLSelectElement
    ).value;
    const category = (
      document.getElementById("filter-category") as HTMLSelectElement
    ).value;

    const params = new URLSearchParams({ search, status, priority, category });
    try {
      const res = await fetch(`${API_URL}/tickets?${params.toString()}`, {
        headers: { Authorization: `Bearer ${currentToken}` },
      });
      if (!res.ok) return;
      const data = await res.json();

      const tbody = document.getElementById("tickets-table-body")!;
      tbody.innerHTML = "";

      const userRoleLower = String(user.role || "")
        .toLowerCase()
        .trim();

      // Permisos diferenciados por rol
      const isStaff =
        userRoleLower === "tecnico" ||
        userRoleLower === "admin" ||
        userRoleLower === "administrador";
      const isAdmin =
        userRoleLower === "admin" || userRoleLower === "administrador";

      const availableStatuses = [
        "Abierto",
        "Asignado",
        "En progreso",
        "Resuelto",
        "Cerrado",
      ];

      data.tickets.forEach((t: any) => {
        const tr = document.createElement("tr");
        tr.className = "hover:bg-slate-750 transition";

        // Control de Estado (Combobox interactivo para técnicos/admin, etiqueta estática para empleado)
        let statusControl = "";
        if (isStaff) {
          const optionsHtml = availableStatuses
            .map(
              (st) =>
                `<option value="${st}" ${t.status === st ? "selected" : ""}>${st}</option>`,
            )
            .join("");

          statusControl = `
            <select onchange="window.updateStatus(${t.id}, this.value)" class="bg-slate-900 border border-slate-700 text-xs text-slate-200 rounded px-2 py-1 focus:outline-none focus:border-blue-500 cursor-pointer">
              ${optionsHtml}
            </select>
          `;
        } else {
          statusControl = `<span class="px-2 py-1 rounded text-xs font-semibold bg-slate-700 text-slate-300">${t.status}</span>`;
        }

        // Columna de Acciones: Botón Eliminar ÚNICAMENTE para Administradores
        let actionsHtml = "";
        if (isAdmin) {
          actionsHtml = `
            <button onclick="window.deleteTicket(${t.id}, '${t.code}')" class="text-xs px-2.5 py-1 bg-red-900/30 hover:bg-red-800 text-red-300 border border-red-800/60 rounded transition">
              Eliminar
            </button>
          `;
        } else {
          actionsHtml = `<span class="text-xs text-slate-500 select-none">—</span>`;
        }

        tr.innerHTML = `
          <td class="p-3 font-mono font-bold text-blue-400">${t.code}</td>
          <td class="p-3 font-medium text-white">${t.title}</td>
          <td class="p-3 text-slate-300">${t.category}</td>
          <td class="p-3">
            <span class="px-2 py-0.5 rounded text-xs font-semibold ${
              t.priority === "Crítica"
                ? "bg-red-900/60 text-red-300"
                : t.priority === "Alta"
                  ? "bg-amber-900/60 text-amber-300"
                  : "bg-slate-700 text-slate-300"
            }">${t.priority}</span>
          </td>
          <td class="p-3">${statusControl}</td>
          <td class="p-3 text-slate-400">${t.solicitante}</td>
          <td class="p-3 text-right">${actionsHtml}</td>
        `;

        tbody.appendChild(tr);
      });
    } catch (err) {
      console.error(err);
    }
  }

  // Escuchar cambios reactivos en los filtros de búsqueda
  [
    "filter-search",
    "filter-status",
    "filter-priority",
    "filter-category",
  ].forEach((id) => {
    document.getElementById(id)!.addEventListener("input", () => loadTickets());
  });

  // Envío del formulario de creación de ticket
  document
    .getElementById("create-ticket-form")!
    .addEventListener("submit", async (e) => {
      e.preventDefault();
      const currentToken = localStorage.getItem("token");
      const title = (document.getElementById("t-title") as HTMLInputElement)
        .value;
      const category = (
        document.getElementById("t-category") as HTMLSelectElement
      ).value;
      const priority = (
        document.getElementById("t-priority") as HTMLSelectElement
      ).value;
      const description = (
        document.getElementById("t-desc") as HTMLTextAreaElement
      ).value;

      const res = await fetch(`${API_URL}/tickets`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${currentToken}`,
        },
        body: JSON.stringify({ title, category, priority, description }),
      });

      if (res.ok) {
        modal.classList.add("hidden");
        (
          document.getElementById("create-ticket-form") as HTMLFormElement
        ).reset();
        loadTickets();
        loadDashboard();
      }
    });

  // Modificación reactiva de estado (técnico y admin)
  (window as any).updateStatus = async (id: number, newStatus: string) => {
    const currentToken = localStorage.getItem("token");
    try {
      const res = await fetch(`${API_URL}/tickets/${id}/status`, {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${currentToken}`,
        },
        body: JSON.stringify({ status: newStatus }),
      });

      if (res.ok) {
        loadDashboard();
      } else {
        const data = await res.json();
        alert(data.error || "No se pudo actualizar el estado.");
        loadTickets();
      }
    } catch (err) {
      console.error(err);
      loadTickets();
    }
  };

  // Eliminación permanente de incidencias (exclusivo para perfil admin)
  (window as any).deleteTicket = async (id: number, code: string) => {
    const confirmDelete = confirm(
      `¿Estás seguro de eliminar permanentemente el ticket ${code}?`,
    );
    if (!confirmDelete) return;

    const currentToken = localStorage.getItem("token");
    try {
      const res = await fetch(`${API_URL}/tickets/${id}`, {
        method: "DELETE",
        headers: {
          Authorization: `Bearer ${currentToken}`,
        },
      });

      if (res.ok) {
        loadTickets();
        loadDashboard();
      } else {
        const data = await res.json();
        alert(data.error || "Acción no autorizada.");
      }
    } catch (err) {
      console.error(err);
      alert("Error de conexión al intentar eliminar.");
    }
  };

  // Carga inicial de datos al abrir el panel
  loadDashboard();
  loadTickets();
</script>
