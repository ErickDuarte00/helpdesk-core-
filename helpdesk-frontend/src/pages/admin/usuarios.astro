---
/**
 * ARCHIVO: src/pages/admin/usuarios.astro
 * DESCRIPCIÓN: Gestión de usuarios con soporte para Soft Delete (Activar/Desactivar).
 */
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Gestión de Usuarios | Administrador">
    <header
        class="bg-slate-800 border-b border-slate-700 px-6 py-4 flex justify-between items-center"
    >
        <div class="flex items-center gap-6">
            <div class="text-xl font-black tracking-wider text-white">
                HELPDESK <span class="text-blue-500">IT</span>
            </div>
            <nav class="hidden md:flex items-center gap-2">
                <a
                    href="/admin"
                    class="px-3 py-1.5 rounded-lg text-sm font-semibold text-slate-300 hover:text-white hover:bg-slate-700/60 transition"
                >
                    Tickets
                </a>
                <a
                    href="/admin/usuarios"
                    class="px-3 py-1.5 rounded-lg text-sm font-semibold bg-slate-700 text-white"
                >
                    Gestión de Usuarios
                </a>
            </nav>
        </div>

        <div class="flex items-center gap-3">
            <span id="user-name" class="font-bold text-white text-base"></span>
            <span
                id="user-role"
                class="px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-purple-900/50 border border-purple-700/60 text-purple-300"
            ></span>
            <button
                id="btn-logout"
                class="px-3.5 py-1.5 border border-slate-600 hover:bg-slate-700 text-slate-200 rounded-lg text-sm transition ml-1"
            >
                Salir
            </button>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 py-8">
        <div class="flex justify-between items-center mb-6">
            <div>
                <h1 class="text-2xl font-bold text-white">
                    Usuarios del Sistema
                </h1>
                <p class="text-sm text-slate-400 mt-0.5">
                    Control de cuentas y asignación de privilegios de acceso
                </p>
            </div>
            <button
                id="btn-open-user-modal"
                class="bg-blue-600 hover:bg-blue-500 text-white font-semibold px-4 py-2 rounded-lg transition shadow-md"
            >
                + Crear usuario
            </button>
        </div>

        <!-- Tabla de Usuarios -->
        <div
            class="bg-slate-800 border border-slate-700 rounded-xl overflow-hidden shadow"
        >
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr
                        class="border-b border-slate-700 bg-slate-850 text-slate-400"
                    >
                        <th class="p-3.5">Nombre</th>
                        <th class="p-3.5">Correo</th>
                        <th class="p-3.5">Rol</th>
                        <th class="p-3.5">Estado</th>
                        <th class="p-3.5 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody
                    id="users-table-body"
                    class="divide-y divide-slate-700 text-slate-200"
                >
                    <!-- Dinámico -->
                </tbody>
            </table>
        </div>
    </main>

    <!-- Modal Crear Usuario -->
    <div
        id="modal-user"
        class="fixed inset-0 bg-black/75 flex items-center justify-center p-4 hidden z-50"
    >
        <div
            class="bg-slate-800 border border-slate-700 rounded-xl w-full max-w-md p-6 shadow-2xl"
        >
            <h2 class="text-xl font-bold text-white mb-4">
                Crear Nuevo Usuario
            </h2>

            <form id="create-user-form" class="space-y-4">
                <div>
                    <label
                        class="block text-xs font-semibold text-slate-300 uppercase mb-1"
                        >Nombre Completo</label
                    >
                    <input
                        type="text"
                        id="u-name"
                        required
                        placeholder="Ej: Juan Pérez"
                        class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-blue-500"
                    />
                </div>

                <div>
                    <label
                        class="block text-xs font-semibold text-slate-300 uppercase mb-1"
                        >Correo Electrónico</label
                    >
                    <input
                        type="email"
                        id="u-email"
                        required
                        placeholder="correo@empresa.com"
                        class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-blue-500"
                    />
                </div>

                <div>
                    <label
                        class="block text-xs font-semibold text-slate-300 uppercase mb-1"
                        >Contraseña Inicial</label
                    >
                    <input
                        type="password"
                        id="u-password"
                        required
                        placeholder="••••••••"
                        class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-blue-500"
                    />
                </div>

                <div>
                    <label
                        class="block text-xs font-semibold text-slate-300 uppercase mb-1"
                        >Rol en el Sistema</label
                    >
                    <select
                        id="u-role"
                        required
                        class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none"
                    >
                        <option value="empleado">Empleado</option>
                        <option value="tecnico">Técnico</option>
                        <option value="admin">Administrador</option>
                    </select>
                </div>

                <p id="user-modal-error" class="text-xs text-red-400 hidden">
                </p>

                <div class="flex justify-end gap-2 pt-3">
                    <button
                        type="button"
                        id="btn-close-user-modal"
                        class="px-4 py-2 border border-slate-600 hover:bg-slate-700 rounded-lg text-slate-300 text-sm"
                        >Cancelar</button
                    >
                    <button
                        type="submit"
                        class="px-4 py-2 bg-blue-600 hover:bg-blue-500 rounded-lg text-white font-semibold text-sm"
                        >Guardar Usuario</button
                    >
                </div>
            </form>
        </div>
    </div>
</Layout>

<script>
    const API_URL = "http://127.0.0.1:3000/api";
    const token = localStorage.getItem("token");
    const user = JSON.parse(localStorage.getItem("user") || "{}");

    if (!token || !user.id) {
        window.location.href = "/";
    }

    const userRole = String(user.role || "")
        .toLowerCase()
        .trim();
    if (userRole !== "admin" && userRole !== "administrador") {
        window.location.href = "/";
    }

    document.getElementById("user-name")!.textContent = user.name;
    document.getElementById("user-role")!.textContent = user.role;
    // CÓDIGO CORREGIDO:
    document.getElementById("btn-logout")?.addEventListener("click", () => {
        localStorage.clear();
        window.location.replace("/"); // <-- Reemplaza la entrada en el historial para no poder retroceder
    });

    const modal = document.getElementById("modal-user")!;
    const errorMsg = document.getElementById("user-modal-error")!;

    document
        .getElementById("btn-open-user-modal")!
        .addEventListener("click", () => {
            errorMsg.classList.add("hidden");
            modal.classList.remove("hidden");
        });
    document
        .getElementById("btn-close-user-modal")!
        .addEventListener("click", () => modal.classList.add("hidden"));

    async function loadUsers() {
        try {
            const res = await fetch(`${API_URL}/users`, {
                headers: { Authorization: `Bearer ${token}` },
            });
            if (!res.ok) return;
            const data = await res.json();

            const tbody = document.getElementById("users-table-body")!;
            tbody.innerHTML = "";

            data.users.forEach((u: any) => {
                const tr = document.createElement("tr");
                tr.className = `transition ${u.is_active ? "hover:bg-slate-750" : "bg-slate-900/40 opacity-70"}`;

                const roleLower = String(u.role).toLowerCase();
                let roleBadgeClass = "bg-slate-700 text-slate-300";
                if (roleLower === "admin" || roleLower === "administrador") {
                    roleBadgeClass =
                        "bg-purple-900/60 text-purple-300 border border-purple-700/50";
                } else if (roleLower === "tecnico") {
                    roleBadgeClass =
                        "bg-blue-900/60 text-blue-300 border border-blue-700/50";
                }

                // Badge de Estado (Activo / Inactivo)
                const statusBadge = u.is_active
                    ? `<span class="px-2 py-0.5 rounded text-xs font-semibold bg-emerald-900/60 text-emerald-300 border border-emerald-700/50">Activo</span>`
                    : `<span class="px-2 py-0.5 rounded text-xs font-semibold bg-slate-800 text-slate-400 border border-slate-700">Inactivo</span>`;

                // Botones de acción: Desactivar/Reactivar + Borrar Definitivo (si fue error de captura)
                const isSelf = u.id === user.id;
                let actionButtons = "";

                if (isSelf) {
                    actionButtons = `<span class="text-xs text-slate-500 italic">Sesión actual</span>`;
                } else {
                    const toggleBtn = u.is_active
                        ? `<button onclick="window.toggleStatus(${u.id}, '${u.name}', false)" class="text-xs px-2.5 py-1 bg-amber-900/30 hover:bg-amber-800 text-amber-300 border border-amber-800/60 rounded transition">Desactivar</button>`
                        : `<button onclick="window.toggleStatus(${u.id}, '${u.name}', true)" class="text-xs px-2.5 py-1 bg-emerald-900/30 hover:bg-emerald-800 text-emerald-300 border border-emerald-800/60 rounded transition">Reactivar</button>`;

                    const deleteBtn = `
            <button onclick="window.deletePermanent(${u.id}, '${u.name}')" title="Eliminar definitivamente si se creó por error" class="text-xs px-2 py-1 bg-red-900/30 hover:bg-red-800 text-red-300 border border-red-800/60 rounded transition">
              Eliminar
            </button>
          `;

                    actionButtons = `<div class="flex items-center justify-end gap-1.5">${toggleBtn} ${deleteBtn}</div>`;
                }

                tr.innerHTML = `
          <td class="p-3.5 font-medium text-white">${u.name}</td>
          <td class="p-3.5 text-slate-300 font-mono text-xs">${u.email}</td>
          <td class="p-3.5">
            <span class="px-2 py-0.5 rounded text-xs font-semibold uppercase ${roleBadgeClass}">
              ${u.role}
            </span>
          </td>
          <td class="p-3.5">${statusBadge}</td>
          <td class="p-3.5 text-right">${actionButtons}</td>
        `;
                tbody.appendChild(tr);
            });
        } catch (err) {
            console.error(err);
        }
    }

    // Función global: Eliminar permanente (Hard Delete seguro)
    (window as any).deletePermanent = async (id: number, name: string) => {
        const confirmDelete = confirm(
            `¿Deseas eliminar permanentemente a "${name}"?\n\n(Solo se completará si el usuario fue creado por error y no tiene tickets ni comentarios registrados).`,
        );
        if (!confirmDelete) return;

        try {
            const res = await fetch(`${API_URL}/users/${id}`, {
                method: "DELETE",
                headers: { Authorization: `Bearer ${token}` },
            });

            const data = await res.json();
            if (res.ok) {
                alert(data.message);
                loadUsers();
            } else {
                alert(data.error);
            }
        } catch (err) {
            console.error(err);
            alert("Error de conexión al intentar eliminar.");
        }
    };

    // Crear usuario
    document
        .getElementById("create-user-form")!
        .addEventListener("submit", async (e) => {
            e.preventDefault();
            errorMsg.classList.add("hidden");

            const name = (document.getElementById("u-name") as HTMLInputElement)
                .value;
            const email = (
                document.getElementById("u-email") as HTMLInputElement
            ).value;
            const password = (
                document.getElementById("u-password") as HTMLInputElement
            ).value;
            const role = (
                document.getElementById("u-role") as HTMLSelectElement
            ).value;

            try {
                const res = await fetch(`${API_URL}/users`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        Authorization: `Bearer ${token}`,
                    },
                    body: JSON.stringify({ name, email, password, role }),
                });

                const data = await res.json();
                if (!res.ok)
                    throw new Error(data.error || "Error al crear usuario.");

                modal.classList.add("hidden");
                (
                    document.getElementById(
                        "create-user-form",
                    ) as HTMLFormElement
                ).reset();
                loadUsers();
            } catch (err: any) {
                errorMsg.textContent = err.message;
                errorMsg.classList.remove("hidden");
            }
        });

    // Soft Delete: Función global para desactivar o reactivar
    (window as any).toggleStatus = async (
        id: number,
        name: string,
        activate: boolean,
    ) => {
        const actionWord = activate ? "reactivar" : "desactivar";
        const confirmAction = confirm(
            `¿Estás seguro de ${actionWord} la cuenta de "${name}"?`,
        );
        if (!confirmAction) return;

        try {
            const res = await fetch(`${API_URL}/users/${id}/status`, {
                method: "PATCH",
                headers: {
                    "Content-Type": "application/json",
                    Authorization: `Bearer ${token}`,
                },
                body: JSON.stringify({ is_active: activate }),
            });

            const data = await res.json();
            if (res.ok) {
                loadUsers();
            } else {
                alert(
                    data.error || "No se pudo cambiar el estado del usuario.",
                );
            }
        } catch (err) {
            console.error(err);
        }
    };

    loadUsers();
</script>
